# Copy to .env (git-ignored). Docker Compose reads it when starting MariaDB.
MARIADB_ROOT_PASSWORD=change-me
MARIADB_VERSION=12.3.3
# The page connects as its own user, timemachine_page, which may only read, and add to the cache of exact texts.
# scripts/install.sh creates that user with this password (letters, digits, - and _).
PAGE_DB_PASSWORD=change-me-too
# The page asks Wikipedia for the exact text of a revision the first time it is
# opened and keeps it. Set to off to stay offline: it then shows the stored
# quarterly copy.
EXACT_TEXT=on
